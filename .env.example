# Postgres connection string (e.g. Neon, Supabase, Railway, or your own server)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Random string of 32+ characters used to sign login sessions.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=

# Claude (hand analysis, recommendations, turning descriptions into designs)
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Image model that paints the nails onto the customer's photo
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high  (higher = better and more expensive per image)
# OPENAI_IMAGE_QUALITY=medium

# Creem payments — https://www.creem.io/dashboard/developers
CREEM_API_KEY=
# Signing secret of your webhook endpoint (Developers → Webhooks)
CREEM_WEBHOOK_SECRET=
# ID of the one-time-payment product the credit packs are sold through (prod_...)
CREEM_PRODUCT_ID=
# "true" while using test-mode keys; remove or set to "false" when going live
CREEM_TEST_MODE=true

# Public URL of the site, used for the after-payment redirect
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Free credits for every new account
FREE_CREDITS_ON_SIGNUP=3

# Shown in the footer and the legal pages (terms, privacy, refund)
SUPPORT_EMAIL=you@example.com
# Your name or business name, shown in the terms of service
OPERATOR_NAME=
