# Postgres connection string (e.g. Neon, Supabase, Railway, or your own server)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Random string of 32+ characters used to sign login sessions.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=

# Claude (hand analysis, recommendations, turning descriptions into designs)
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Image model that paints the nails onto the customer's photo
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high  (higher = better and more expensive per image)
# OPENAI_IMAGE_QUALITY=medium

# Stripe payments — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of your webhook endpoint (starts with whsec_)
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL of the site, used for Stripe success/cancel redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Free credits for every new account
FREE_CREDITS_ON_SIGNUP=3
